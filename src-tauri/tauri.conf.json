{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "win11clip",
  "version": "0.7.5",
  "identifier": "io.github.harshp2008.win11clip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "title": "Win11Clip",
        "label": "main",
        "width": 360,
        "height": 480,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      },
      {
        "title": "Setup - Win11Clip",
        "label": "setup",
        "width": 550,
        "height": 650,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "focus": true
      },
      {
        "title": "Settings - Win11Clip",
        "label": "settings",
        "width": 480,
        "height": 520,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "category": "Utility",
    "publisher": "harshp2008",
    "homepage": "https://github.com/harshp2008/Win11Clip",
    "copyright": "Copyright (c) 2024 Windows 11 Clipboard History For Linux Contributors; Copyright (c) 2026 harshp2008",
    "shortDescription": "Windows 11-style Clipboard History Manager",
    "longDescription": "A modern, beautiful clipboard history manager for Linux that mimics the Windows 11 Win+V clipboard experience. Built with Tauri, React, and Rust.",
    "linux": {
      "deb": {
        "depends": [
          "xclip",
          "xdotool",
          "wl-clipboard",
          "acl",
          "polkitd | policykit-1",
          "pkexec | policykit-1"
        ],
        "provides": [
          "win11-clipboard-history"
        ],
        "conflicts": [
          "win11-clipboard-history"
        ],
        "replaces": [
          "win11-clipboard-history"
        ],
        "desktopTemplate": "bundle/linux/appimage.desktop",
        "files": {
          "/usr/bin/win11clip": "bundle/linux/wrapper.sh",
          "/etc/udev/rules.d/99-win11-clipboard-input.rules": "bundle/linux/99-win11-clipboard-input.rules",
          "/usr/share/applications/win11clip.desktop": "bundle/linux/win11clip-hidden.desktop",
          "/usr/share/applications/io.github.harshp2008.win11clip.desktop": "bundle/linux/io.github.harshp2008.win11clip.desktop",
          "/usr/share/icons/hicolor/128x128/apps/io.github.harshp2008.win11clip.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.harshp2008.win11clip.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/io.github.harshp2008.win11clip.svg": "icons/icon.svg",
          "/usr/share/metainfo/io.github.harshp2008.win11clip.metainfo.xml": "bundle/linux/io.github.harshp2008.win11clip.metainfo.xml"
        },
        "postInstallScript": "bundle/linux/postinst.sh",
        "preRemoveScript": "bundle/linux/postrm.sh"
      },
      "rpm": {
        "depends": [
          "xclip",
          "xdotool",
          "wl-clipboard",
          "acl",
          "polkit",
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "provides": [
          "win11-clipboard-history"
        ],
        "conflicts": [
          "win11-clipboard-history"
        ],
        "obsoletes": [
          "win11-clipboard-history"
        ],
        "desktopTemplate": "bundle/linux/win11clip-hidden.desktop",
        "files": {
          "/usr/bin/win11clip": "bundle/linux/wrapper.sh",
          "/etc/udev/rules.d/99-win11-clipboard-input.rules": "bundle/linux/99-win11-clipboard-input.rules",
          "/usr/share/applications/io.github.harshp2008.win11clip.desktop": "bundle/linux/io.github.harshp2008.win11clip.desktop",
          "/usr/share/icons/hicolor/128x128/apps/io.github.harshp2008.win11clip.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.harshp2008.win11clip.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/io.github.harshp2008.win11clip.svg": "icons/icon.svg",
          "/usr/share/metainfo/io.github.harshp2008.win11clip.metainfo.xml": "bundle/linux/io.github.harshp2008.win11clip.metainfo.xml"
        },
        "postInstallScript": "bundle/linux/postinst.sh",
        "preRemoveScript": "bundle/linux/postrm.sh"
      }
    },
    "resources": [
      "bundle/linux/99-win11-clipboard-input.rules"
    ]
  }
}